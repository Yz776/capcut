# ============== CapCut JJ API Config ==============
# Server
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000

# Browser (Puppeteer)
# Set to false saat production untuk headless true
HEADLESS=true
# SlowMo ms - useful saat debugging selector
SLOW_MO=0
# Window
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
# Timeout general (ms) - render CapCut bisa lama
NAV_TIMEOUT=60000
RENDER_TIMEOUT=300000

# CapCut Credentials
# Email/password login - isi dengan akun CapCut kamu
CAPCUT_EMAIL=
CAPCUT_PASSWORD=
# Atau, kalau sudah pernah login, kasih path ke userDataDir (persistent context)
# Lewati kalau kosong - akan pakai email/password di atas
CAPCUT_USER_DATA_DIR=

# CapCut Base URL
CAPCUT_BASE_URL=https://www.capcut.com
CAPCUT_TEMPLATES_PATH=/templates

# Storage
DOWNLOAD_DIR=./downloads
VIDEO_DIR=./videos
TMP_DIR=./tmp
# Hapus file tmp setelah berapa menit (0 = tidak dihapus)
TMP_TTL_MINUTES=60

# Job concurrency (jumlah browser paralel)
MAX_CONCURRENT_JOBS=1
# Job TTL (job lama dihapus dari memory setelah berapa menit)
JOB_TTL_MINUTES=120

# Logging
LOG_LEVEL=info
