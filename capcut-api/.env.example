# ============== CapCut JJ API Config ==============
# Server
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000

# Browser (Puppeteer)
# Set to false saat production untuk headless true
HEADLESS=true
# SlowMo ms - useful saat debugging selector
SLOW_MO=0
# Window
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
# Timeout general (ms) - render CapCut bisa lama
NAV_TIMEOUT=60000
RENDER_TIMEOUT=300000

# CapCut editor automation (default: false)
# Set CAPCUT_EDITOR_ENABLED=true untuk coba render via CapCut editor (butuh session login
# lengkap dengan sessionid + sid_guard). QR login basic tidak cukup.
# Default false: langsung pakai ffmpeg composer (overlay images ke template preview MP4).
CAPCUT_EDITOR_ENABLED=false

# CapCut Credentials
# Email/password login - isi dengan akun CapCut kamu
CAPCUT_EMAIL=
CAPCUT_PASSWORD=
# Atau, kalau sudah pernah login, kasih path ke userDataDir (persistent context)
# Lewati kalau kosong - akan pakai email/password di atas
CAPCUT_USER_DATA_DIR=

# CapCut Base URL
CAPCUT_BASE_URL=https://www.capcut.com
CAPCUT_TEMPLATES_PATH=/templates

# Storage
DOWNLOAD_DIR=./downloads
VIDEO_DIR=./videos
TMP_DIR=./tmp
# Hapus file tmp setelah berapa menit (0 = tidak dihapus)
TMP_TTL_MINUTES=60

# Job concurrency (jumlah browser paralel)
MAX_CONCURRENT_JOBS=1
# Job TTL (job lama dihapus dari memory setelah berapa menit)
JOB_TTL_MINUTES=120

# FFmpeg / ffprobe binary paths (required by the ffmpeg fallback composer)
# Default: rely on PATH lookup (bare 'ffmpeg' / 'ffprobe').
# Set absolute path here if the Node process can't find them — common with
# pm2, systemd, Docker slim images, or VS Code task launchers that strip PATH.
# Verify from a normal shell: `which ffmpeg` and `which ffprobe`
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Logging
LOG_LEVEL=info
